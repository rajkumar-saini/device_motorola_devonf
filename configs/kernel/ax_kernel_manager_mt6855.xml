        node="/proc/gpufreqv2"
        currentNode="/sys/kernel/ged/hal/current_freqency"
        usageNode="/sys/kernel/ged/hal/gpu_utilization"
        frequencyMultiplier="1"
        values="950000,943000,937000,931000,925000,918000,912000,906000,900000,885000,870000,855000,840000,825000,810000,795000,780000,765000,750000,735000,720000,705000,690000,675000,660000,637000,615000,592000,570000,547000,525000,502000,480000,457000,435000,412000,390000" />

</kernel-manager>
